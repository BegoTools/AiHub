{
  "name": "aihub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server.ts",
    "build": "vite build",
    "start": "vite preview",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:build:debug": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug",
    "cap:build:release": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease",
    "cap:logs": "adb logcat -s \"Capacitor/Console\" | findstr \"OAuth DeepLink AuthCallback Redirect Auth\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@google/genai": "^2.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.19",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
